{
  "name": "fundkeep-indexer",
  "version": "0.1.0",
  "description": "Indexes FundKeep Soroban contract events into SQLite and serves them over a small REST API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "keeper": "tsx scripts/keeper.ts",
    "keeper:once": "tsx scripts/keeper.ts --once"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
