# Required: the deployed FundKeep Soroban contract address.
CONTRACT_ID=

# Optional overrides.
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PORT=4000
DB_PATH=./data/fundkeep.db
POLL_INTERVAL_MS=5000

# How far back (in ledgers) to start indexing on first run, if there's no
# saved cursor yet. ~1000 ledgers is roughly 1.5 hours at 5s/ledger.
EVENTS_BACKFILL_LEDGERS=1000

# Comma-separated list of origins allowed to call this API (e.g. the app's
# deployed URL). Defaults to allowing all origins.
CORS_ORIGINS=

# Optional keeper bot configuration for automatic deadline unlock execution
KEEPER_SECRET_KEY=
KEEPER_INTERVAL_MS=30000
